{
  "$comment": "Wire fixtures for the captured-workout import requests on the PlanMyPeak site-control channel. Mirrored verbatim in the PlanMyPeak app at apps/web/src/lib/extension/__fixtures__/captured-imports.json; both repositories test against this file, so a change here is a protocol change and must land in both.",
  "protocolVersion": 1,
  "requestTypes": [
    "GET_CAPTURED_WORKOUT_SUMMARY",
    "IMPORT_MISSING_WORKOUTS",
    "GET_CAPTURED_WORKOUT_IMPORT_STATUS"
  ],
  "requests": {
    "valid": [
      {
        "name": "summary with payload omitted",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-summary-1",
          "type": "GET_CAPTURED_WORKOUT_SUMMARY"
        }
      },
      {
        "name": "summary with empty payload",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-summary-2",
          "type": "GET_CAPTURED_WORKOUT_SUMMARY",
          "payload": {}
        }
      },
      {
        "name": "import start",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-start-1",
          "type": "IMPORT_MISSING_WORKOUTS",
          "payload": {
            "contextId": "ctx_0123456789abcdef",
            "operationId": "op-7f3a"
          }
        }
      },
      {
        "name": "import status",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-status-1",
          "type": "GET_CAPTURED_WORKOUT_IMPORT_STATUS",
          "payload": {
            "contextId": "ctx_0123456789abcdef",
            "operationId": "op-7f3a"
          }
        }
      }
    ],
    "invalid": [
      {
        "name": "import start without an operation id",
        "expectedCode": "INVALID_REQUEST",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-bad-1",
          "type": "IMPORT_MISSING_WORKOUTS",
          "payload": { "contextId": "ctx_0123456789abcdef" }
        }
      },
      {
        "name": "import start with an empty context id",
        "expectedCode": "INVALID_REQUEST",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-bad-2",
          "type": "IMPORT_MISSING_WORKOUTS",
          "payload": { "contextId": "", "operationId": "op-1" }
        }
      },
      {
        "name": "import start smuggling a destination",
        "expectedCode": "INVALID_REQUEST",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-bad-3",
          "type": "IMPORT_MISSING_WORKOUTS",
          "payload": {
            "contextId": "ctx_0123456789abcdef",
            "operationId": "op-1",
            "libraryId": "lib-9"
          }
        }
      },
      {
        "name": "import start smuggling an acting coach",
        "expectedCode": "INVALID_REQUEST",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-bad-4",
          "type": "IMPORT_MISSING_WORKOUTS",
          "payload": {
            "contextId": "ctx_0123456789abcdef",
            "operationId": "op-1",
            "coachId": "coach-b"
          }
        }
      },
      {
        "name": "status without a context id",
        "expectedCode": "INVALID_REQUEST",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-bad-5",
          "type": "GET_CAPTURED_WORKOUT_IMPORT_STATUS",
          "payload": { "operationId": "op-1" }
        }
      },
      {
        "name": "summary on a protocol version this build does not speak",
        "expectedCode": "UNSUPPORTED_VERSION",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 2,
          "requestId": "req-bad-6",
          "type": "GET_CAPTURED_WORKOUT_SUMMARY"
        }
      },
      {
        "name": "the raw capture channel is not a site-control request",
        "expectedCode": "UNSUPPORTED_REQUEST_TYPE",
        "envelope": {
          "source": "planmypeak-site-control",
          "version": 1,
          "requestId": "req-bad-7",
          "type": "GET_CAPTURED_WORKOUTS"
        }
      }
    ]
  },
